{
  "name": "korean-review-web",
  "version": "1.0.0",
  "description": "在學習語言或背誦知識時，有一個很重要的記憶理論叫做「艾賓浩斯遺忘曲線」，搭配的實際學習方法則叫做「間隔重複」。",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/check_bundle_budget.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "test:web": "node --test tests/*.test.mjs",
    "test:terminal": "python -m unittest discover -s tests -p 'test_terminal*.py'",
    "test:architecture": "node --test tests/architecture-boundaries.test.mjs && node scripts/report_file_sizes.mjs",
    "test:visual": "playwright test",
    "test:app": "firebase emulators:exec --only auth,firestore --project demo-korean-review-web \"playwright test --config playwright.app.config.js\"",
    "test:visual:update": "playwright test --update-snapshots",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-korean-review-web \"node --test tests/emulator/*.test.mjs\"",
    "db:migrate-review-days": "node --env-file=.env scripts/migrate_review_days.mjs",
    "db:migrate-word-pos": "node --env-file=.env scripts/migrate_word_pos.mjs"
  },
  "keywords": [],
  "author": "",
  "private": true,
  "license": "ISC",
  "dependencies": {
    "firebase": "^10.14.1",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^4.3.4",
    "firebase-tools": "^15.30.0",
    "vite": "^5.4.14",
    "vite-plugin-pwa": "^1.3.0"
  }
}
