rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/records/{recordId} {
      allow read, write: if isOwner(uid);
    }
    match /users/{uid}/grammarNotes/{noteId} {
      allow read, write: if isOwner(uid);
    }
    match /users/{uid}/ytSubtitles/{subtitleId} {
      allow read, write: if isOwner(uid);
    }
    match /users/{uid}/readingTests/{testId} {
      allow read, write: if isOwner(uid);
    }
    match /users/{uid}/folders/{folderId} {
      allow read, write: if isOwner(uid);
    }
    match /users/{uid}/progressShards/{shardId} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && shardId.matches('^(0[0-9]|1[0-5])$');
    }
    match /users/{uid}/reviewDays/{date} {
      allow read, write: if isOwner(uid);
    }
    match /users/{uid}/reviewDays/{date}/attemptSegments/{segmentId} {
      allow read, write: if isOwner(uid);
    }
    match /users/{uid}/settings/review {
      allow read, create: if isOwner(uid);
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['completedReviewDates']);
      allow update: if isOwner(uid)
        && request.resource.data.get('completedReviewDates', []) is list
        && request.resource.data.get('completedReviewDates', [])
          .hasAll(resource.data.get('completedReviewDates', []));
      allow delete: if false;
    }
    match /users/{uid}/settings/grammarReview {
      allow read, create, update: if isOwner(uid);
      allow delete: if false;
    }
  }
}
